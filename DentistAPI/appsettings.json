{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "UseMockSpeechToText": false,
  "GEMINI_API_KEY": "${GEMINI_API_KEY}",
  "GEMINI_MODEL": "gemini-flash-latest",
  "SmtpSettings": {
    "EnableSmtp": false,
    "Host": "smtp.office365.com",
    "Port": 587,
    "Username": "${SMTP_USERNAME}",
    "Password": "${SMTP_PASSWORD}",
    "FromAddress": "noreply@dentia.clinic"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=DentistAPI;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  }
}